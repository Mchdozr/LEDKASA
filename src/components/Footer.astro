---
import { businessContact, products } from '../data/site';

const footerProductSlugs = [
  'kapaksiz-led-kabinet',
  'rental-led-kabinet',
  'poster-led-kasa',
  'katlanabilir-poster-led-kasa',
] as const;

const footerProducts = footerProductSlugs.map((slug) => {
  const product = products.find((entry) => entry.slug === slug);
  if (!product) throw new Error(`Footer ürünü bulunamadı: ${slug}`);
  return product;
});

const year = new Date().getFullYear();
const whatsappHref = `${businessContact.whatsappUrl}?text=${encodeURIComponent('Merhaba, LED ekran projem için bilgi almak istiyorum.')}`;

const contactChannels = [
  {
    label: 'Telefon',
    value: businessContact.phoneDisplay,
    href: `tel:${businessContact.phoneTel}`,
    external: false,
    icon: 'phone',
  },
  {
    label: 'WhatsApp',
    value: 'WhatsApp ile yazın',
    href: whatsappHref,
    external: true,
    icon: 'whatsapp',
  },
  {
    label: 'E-posta',
    value: businessContact.email,
    href: `mailto:${businessContact.email}`,
    external: false,
    icon: 'mail',
  },
] as const;
---

<footer class="site-footer">
  <div class="footer-accent" aria-hidden="true"></div>
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="/" aria-label="LEDKASA ana sayfa">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>LED<span>KASA</span></span>
      </a>
      <p>LED ekran kasaları ile güç ve bağlantı ekipmanlarında proje odaklı çözümler.</p>
      <a class="button button-outline" href="/teklif-al/">Projenizi Konuşalım</a>
    </div>

    <nav aria-labelledby="footer-products">
      <h2 id="footer-products">Ürünler</h2>
      <ul class="footer-product-list">
        {footerProducts.map((product) => (
          <li>
            <a href={product.url}>
              <span>{product.name}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-corporate">
      <h2 id="footer-corporate">LEDKASA</h2>
      <ul>
        <li><a href="/hakkimizda/">Hakkımızda</a></li>
        <li><a href="/uygulama-alanlari/">Uygulama Alanları</a></li>
        <li><a href="/bilgi-merkezi/">Bilgi Merkezi</a></li>
        <li><a href="/sss/">Sık Sorulan Sorular</a></li>
        <li><a href="/iletisim/">İletişim sayfası</a></li>
        <li><a href="/site-haritasi/">Site Haritası</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal">Yasal</h2>
      <ul>
        <li><a href="/kvkk-aydinlatma/">KVKK Aydınlatma Metni</a></li>
        <li><a href="/gizlilik-politikasi/">Gizlilik Politikası</a></li>
        <li><a href="/cerez-politikasi/">Çerez Politikası</a></li>
      </ul>
    </nav>

    <nav class="footer-contact-nav" aria-labelledby="footer-contact">
      <h2 id="footer-contact">İletişim</h2>
      <ul class="footer-contact-list">
        {contactChannels.map((channel) => (
          <li>
            <a
              class="footer-contact-link"
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener noreferrer' : undefined}
            >
              <span class="footer-contact-icon" aria-hidden="true">
                {channel.icon === 'phone' && (
                  <svg viewBox="0 0 24 24" fill="none"><path d="M7.2 3.8h2.6l1.2 4.2-1.7 1a12.4 12.4 0 0 0 5.7 5.7l1-1.7 4.2 1.2v2.6c0 .9-.7 1.7-1.6 1.7A15.4 15.4 0 0 1 3.5 5.4c0-.9.8-1.6 1.7-1.6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M15.2 4.2c1.7.3 3.2 1.2 4.3 2.4 1.1 1.2 1.8 2.7 2 4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M15.3 7.6c.9.2 1.7.7 2.3 1.4.6.6 1 1.4 1.1 2.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                )}
                {channel.icon === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.4a8.4 8.4 0 0 0-7.2 12.7L3.6 20.4l4.4-1.1A8.4 8.4 0 1 0 12 3.4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9.2 9.1c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.3l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.1.1-.1.3 0 .4.4.7 1.1 1.4 1.9 1.8.2.1.3.1.4 0l.6-.5c.2-.1.3-.1.5 0l1.8.9c.3.1.4.3.3.6v.5c0 .3-.1.5-.4.6-.5.3-1.2.4-1.9.3-1.9-.3-3.7-1.5-5-3.1-1.1-1.4-1.7-4.6 0-.5.1-1 .4-1.4Z" fill="currentColor"/></svg>
                )}
                {channel.icon === 'mail' && (
                  <svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m4.5 7.5 7.5 6 7.5-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
              </span>
              <span class="footer-contact-copy">
                <small>{channel.label}</small>
                <strong>{channel.value}</strong>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="shell footer-bottom">
    <p>© {year} LEDKASA. Tüm hakları saklıdır.</p>
    <p>LED ekran projeleri için kasa ve bağlantı çözümleri.</p>
  </div>
</footer>
