---
import { productCategories } from '../data/site';

const categoryLinks = productCategories.map((category) => ({
  name: category.name,
  url: new URL(category.canonicalUrl).pathname,
}));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-accent" aria-hidden="true"></div>
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="/" aria-label="LEDKASA ana sayfa">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>LED<span>KASA</span></span>
      </a>
      <p>LED ekran kasaları ile güç ve bağlantı ekipmanlarında proje odaklı çözümler.</p>
      <a class="button button-outline" href="/teklif-al/">Projenizi Konuşalım</a>
    </div>
    <nav aria-labelledby="footer-products">
      <h2 id="footer-products">Ürünler</h2>
      <ul>
        <li><a href="/urunler/">Tüm Ürünler</a></li>
        {categoryLinks.map((category) => <li><a href={category.url}>{category.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="footer-corporate">
      <h2 id="footer-corporate">LEDKASA</h2>
      <ul>
        <li><a href="/hakkimizda/">Hakkımızda</a></li>
        <li><a href="/uygulama-alanlari/">Uygulama Alanları</a></li>
        <li><a href="/bilgi-merkezi/">Bilgi Merkezi</a></li>
        <li><a href="/sss/">Sık Sorulan Sorular</a></li>
        <li><a href="/iletisim/">İletişim</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal">Yasal</h2>
      <ul>
        <li><a href="/kvkk-aydinlatma/">KVKK Aydınlatma Metni</a></li>
        <li><a href="/gizlilik-politikasi/">Gizlilik Politikası</a></li>
        <li><a href="/cerez-politikasi/">Çerez Politikası</a></li>
      </ul>
    </nav>
  </div>
  <div class="shell footer-bottom">
    <p>© {year} LEDKASA. Tüm hakları saklıdır.</p>
    <p>LED ekran projeleri için kasa ve bağlantı çözümleri.</p>
  </div>
</footer>
