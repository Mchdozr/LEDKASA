---
import { productCategories } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isCurrent = (url: string) => currentPath === url;

const primaryLinks = [
  { name: 'Uygulama Alanları', url: '/uygulama-alanlari/' },
  { name: 'Bilgi Merkezi', url: '/bilgi-merkezi/' },
  { name: 'Hakkımızda', url: '/hakkimizda/' },
  { name: 'İletişim', url: '/iletisim/' },
];
---

<header class="site-header" data-site-header>
  <div class="header-bar shell">
    <a class="brand" href="/" aria-label="LEDKASA ana sayfa" data-responsive-focus-target>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>LED<span>KASA</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Ana menü">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Ana Sayfa</a>
      <div class="mega-menu-wrap" data-mega-wrap>
        <button
          class="nav-button"
          type="button"
          aria-expanded="false"
          aria-controls="products-mega-menu"
          data-mega-toggle
        >
          Ürünler
          <svg aria-hidden="true" viewBox="0 0 12 8"><path d="m1 1 5 5 5-5" /></svg>
        </button>
        <div class="mega-menu" id="products-mega-menu" data-mega-menu hidden>
          <div class="mega-menu-intro">
            <span class="eyebrow">Ürün kataloğu</span>
            <strong>LED ekran altyapınızı birlikte planlayalım.</strong>
            <a class="text-link" href="/urunler/">Tüm ürünleri incele <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/urunler/kasa-karsilastirma/">Kasa karşılaştırma <span aria-hidden="true">→</span></a>
          </div>
          <div class="mega-menu-catalog">
            {productCategories.map((category) => (
              <section class="mega-category" aria-labelledby={`desktop-${category.slug}`}>
                <a
                  class="mega-category-title"
                  id={`desktop-${category.slug}`}
                  href={category.url}
                  aria-current={isCurrent(category.url) ? 'page' : undefined}
                >
                  {category.name}
                </a>
                <p>{category.description}</p>
                <ul>
                  {category.products.map((product) => (
                    <li>
                      <a href={product.url} aria-current={isCurrent(product.url) ? 'page' : undefined}>
                        {product.name}<span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </div>
      {primaryLinks.map((link) => (
        <a href={link.url} aria-current={isCurrent(link.url) ? 'page' : undefined}>{link.name}</a>
      ))}
    </nav>

    <a class="button button-small header-quote" href="/teklif-al/">Teklif Al</a>
    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label="Menüyü aç"
      aria-expanded="false"
      aria-controls="mobile-primary-nav"
      data-mobile-toggle
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-primary-nav" aria-label="Mobil menü" data-mobile-nav hidden>
    <div class="shell mobile-nav-inner">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Ana Sayfa</a>
      <details class="mobile-accordion" data-mobile-products>
        <summary>Ürünler <span aria-hidden="true">+</span></summary>
        <div class="mobile-accordion-body">
          <a class="mobile-all-products" href="/urunler/">Tüm Ürünler</a>
          <a class="mobile-all-products" href="/urunler/kasa-karsilastirma/">Kasa karşılaştırma</a>
          {productCategories.map((category) => (
            <details class="mobile-category" data-mobile-category>
              <summary>{category.name} <span aria-hidden="true">+</span></summary>
              <div>
                <a
                  class="mobile-category-link"
                  href={category.url}
                  aria-current={isCurrent(category.url) ? 'page' : undefined}
                >
                  Kategoriyi incele
                </a>
                {category.products.map((product) => (
                  <a href={product.url} aria-current={isCurrent(product.url) ? 'page' : undefined}>
                    {product.name}
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      </details>
      {primaryLinks.map((link) => (
        <a href={link.url} aria-current={isCurrent(link.url) ? 'page' : undefined}>{link.name}</a>
      ))}
      <a class="button mobile-quote" href="/teklif-al/">Projeniz İçin Teklif Alın</a>
    </div>
  </nav>
</header>
