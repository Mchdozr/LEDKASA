---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;

const productsHref = home ? '#urunler' : '/urunler';
const aboutHref = home ? '#hakkimizda' : '/#hakkimizda';
const quoteHref = home ? '#iletisim' : '/iletisim';
---

<header class="site-header is-fixed is-dark" id="site-header">
  <a class="logo" href={home ? '#top' : '/'} aria-label="LEDKASA ana sayfa">LED<span>KASA</span></a>
  <button class="menu-toggle" aria-label="Menüyü aç" aria-expanded="false" type="button">
    <i></i><i></i>
  </button>
  <nav class="nav" aria-label="Ana menü">
    <a href={productsHref}>Ürünler</a>
    <a href={aboutHref}>Neden LEDKASA?</a>
    <a href="/urunler">Katalog</a>
    <a href={quoteHref} class="nav-cta">Teklif Al</a>
  </nav>
</header>
