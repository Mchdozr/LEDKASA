---
import { site } from '../data/site';

interface Props {
  heading?: boolean;
}

const { heading = true } = Astro.props;
---

<section class="section contact" id="iletisim">
  {
    heading && (
      <>
        <p class="eyebrow">İletişim</p>
        <h2>
          Projenizi
          <br />
          <em>konuşalım.</em>
        </h2>
      </>
    )
  }
  <div class="contact-grid">
    <a href={site.phoneHref}><small>Telefon</small><strong>{site.phone}</strong></a>
    <a href={`mailto:${site.email}`}><small>E-posta</small><strong>{site.email}</strong></a>
    <a href={site.whatsapp} target="_blank" rel="noopener"
      ><small>Hızlı iletişim</small><strong>WhatsApp <b>↗</b></strong></a
    >
  </div>
  <div class="contact-cta-row">
    <a class="button button-primary" href="/iletisim">Teklif formu ile gönder <b>→</b></a>
    <a class="text-link" href={`mailto:${site.email}`}>Doğrudan e-posta yazın</a>
  </div>
</section>
