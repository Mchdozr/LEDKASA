---
interface Props {
  post: {
    slug: string;
    title: string;
    excerpt: string;
    category: string;
    publishedAt: string;
    image: string;
    imageAlt: string;
  };
  dateLabel: string;
  priority?: boolean;
}

const { post, dateLabel, priority = false } = Astro.props;
---

<article class="blog-card" data-reveal>
  <a class="blog-card-media" href={`/blog/${post.slug}/`} tabindex="-1" aria-hidden="true">
    <img
      src={post.image}
      alt=""
      width="800"
      height="800"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </a>
  <div class="blog-card-body">
    <div class="blog-card-meta">
      <span class="eyebrow">{post.category}</span>
      <time datetime={post.publishedAt}>{dateLabel}</time>
    </div>
    <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
    <p>{post.excerpt}</p>
    <a class="text-link" href={`/blog/${post.slug}/`}>Yazıyı oku <span aria-hidden="true">→</span></a>
  </div>
</article>
