---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../data/site';

const success = Astro.url.searchParams.get('success') === '1';
const selectedProduct = Astro.url.searchParams.get('urun') ?? '';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'İletişim | LEDKASA',
  url: `${site.url}/iletisim`,
  mainEntity: {
    '@type': 'Organization',
    name: site.legalName,
    email: site.email,
    telephone: site.phone,
  },
};
---

<BaseLayout
  title="İletişim & Teklif | LEDKASA"
  description="LED ekran kasa ve bağlantı projeleriniz için teklif alın. Telefon, e-posta, WhatsApp veya form ile ulaşın."
  canonicalPath="/iletisim"
  headerDark
  jsonLd={contactLd}
>
  <main id="top">
    <section class="page-hero dark contact-hero">
      <p class="eyebrow">İletişim</p>
      <h1>Projenizi<br /><em>konuşalım.</em></h1>
      <p class="lede">
        İhtiyacınızı yazın; uygun LED kasa ve bağlantı ekipmanları için size dönüş yapalım.
      </p>
    </section>

    <section class="contact-panel">
      <div>
        <p class="eyebrow">Kanallar</p>
        <h2 style="font-size:clamp(32px,3.4vw,46px); margin-bottom:28px;">
          Tek noktadan<br /><em>teklif.</em>
        </h2>
        <div class="contact-channels">
          <a href={site.phoneHref}><small>Telefon</small><strong>{site.phone}</strong></a>
          <a href={`mailto:${site.email}`}><small>E-posta</small><strong>{site.email}</strong></a>
          <a href={site.whatsapp} target="_blank" rel="noopener"
            ><small>WhatsApp</small><strong>Hızlı yazın ↗</strong></a
          >
        </div>
      </div>
      <div>
        <p class="eyebrow">Teklif formu</p>
        <LeadForm selectedProduct={selectedProduct} success={success} />
      </div>
    </section>
  </main>
</BaseLayout>
