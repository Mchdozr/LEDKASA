---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { businessContact, siteUrl } from '../data/site';

const title = 'İletişim | LEDKASA';
const description = 'LED ekran kasa, kabinet ve bağlantı ekipmanı projeleriniz için LEDKASA ile iletişime geçin veya teklif talebi gönderin.';
const canonical = '/iletisim/';
const whatsappHref = `${businessContact.whatsappUrl}?text=${encodeURIComponent('Merhaba, LED ekran projem için bilgi almak istiyorum.')}`;
const schema = {
  '@type': 'ContactPage',
  '@id': `${siteUrl}${canonical}#contact`,
  url: `${siteUrl}${canonical}`,
  name: title,
  description,
  inLanguage: 'tr-TR',
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Breadcrumbs items={[{ label: 'İletişim' }]} />
  <header class="content-hero content-hero-compact shell">
    <span class="eyebrow">Projeyi birlikte netleştirelim</span>
    <h1>LEDKASA ile iletişime geçin</h1>
    <p>Ürün grubu, kullanım alanı ve kurulum biçimini paylaşın; kapsamı teklif sürecinde birlikte değerlendirelim.</p>
    <div class="hero-inline-actions">
      <a class="button" href="/teklif-al/">Teklif formu</a>
      <a class="text-link" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">→</span></a>
    </div>
  </header>
  <section class="story-section shell" aria-labelledby="contact-heading">
    <div class="story-statement">
      <span class="eyebrow">Doğrudan iletişim</span>
      <h2 id="contact-heading">{businessContact.phoneDisplay}</h2>
      <div class="direct-contact-actions contact-channel-actions">
        <a class="button" href={`tel:${businessContact.phoneTel}`}>Telefonla ara</a>
        <a class="button button-secondary" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
      <p class="contact-email-line"><a href={`mailto:${businessContact.email}`}>{businessContact.email}</a></p>
    </div>
    <div class="story-copy">
      <p>Mesai saatlerinde gelen taleplere genelde aynı iş günü içinde dönüş yapılır. Ürün seçimi veya teklif kapsamı için formu doldurmanız süreci hızlandırır.</p>
      <p>Fiziksel konum bilgisi doğrulandığında bu sayfada ayrıca yayımlanacaktır.</p>
      <nav class="hub-links" aria-label="İletişim sonrası adımlar">
        <a href="/teklif-al/">Teklif formu</a>
        <a href="/sss/">Sık sorulan sorular</a>
        <a href="/urunler/">Ürün kataloğu</a>
        <a href="/site-haritasi/">Site haritası</a>
      </nav>
    </div>
  </section>
  <QuoteCta title="LED ekran projenizi değerlendirmeye başlayalım." />
</BaseLayout>
