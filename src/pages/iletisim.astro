---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { businessContact, companyProfile, siteUrl } from '../data/site';

const title = 'İletişim | LEDKASA';
const description = 'LED ekran kasa, kabinet ve bağlantı ekipmanı projeleriniz için LEDKASA ile iletişime geçin veya teklif talebi gönderin.';
const canonical = '/iletisim/';
const whatsappHref = `${businessContact.whatsappUrl}?text=${encodeURIComponent('Merhaba, LED ekran projem için bilgi almak istiyorum.')}`;
const schema = {
  '@type': 'ContactPage',
  '@id': `${siteUrl}${canonical}#contact`,
  url: `${siteUrl}${canonical}`,
  name: title,
  description,
  inLanguage: 'tr-TR',
};

const channels = [
  {
    label: 'Telefon',
    value: businessContact.phoneDisplay,
    hint: 'Mesai saatlerinde hızlı dönüş',
    href: `tel:${businessContact.phoneTel}`,
    action: 'Hemen Arayın',
    primary: true,
    external: false,
  },
  {
    label: 'WhatsApp',
    value: businessContact.phoneDisplay,
    hint: 'Kısa proje notu bırakın',
    href: whatsappHref,
    action: 'Mesaj Bırakın',
    primary: false,
    external: true,
  },
  {
    label: 'E-posta',
    value: businessContact.email,
    hint: 'Detaylı talep ve dosya paylaşımı',
    href: `mailto:${businessContact.email}`,
    action: 'Mail Atın',
    primary: false,
    external: false,
  },
] as const;
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Breadcrumbs items={[{ label: 'İletişim' }]} />

  <header class="content-hero content-hero-compact shell">
    <span class="eyebrow">İletişim</span>
    <h1>LEDKASA ile iletişime geçin</h1>
    <p>Ürün grubu, kullanım alanı ve kurulum biçimini paylaşın; kapsamı teklif sürecinde birlikte değerlendirelim.</p>
  </header>

  <section class="contact-page shell" aria-labelledby="contact-channels-heading">
    <div class="contact-page-intro">
      <span class="eyebrow">Kanallar</span>
      <h2 id="contact-channels-heading">Size uygun yolu seçin</h2>
      <p>Telefon ve WhatsApp ile hızlı ulaşabilir; kapsamlı talepler için teklif formunu kullanabilirsiniz.</p>
    </div>

    <ul class="contact-channel-list">
      {channels.map((channel) => (
        <li class="contact-channel-card">
          <div class="contact-channel-copy">
            <span class="contact-channel-label">{channel.label}</span>
            <strong class="contact-channel-value">{channel.value}</strong>
            <span class="contact-channel-hint">{channel.hint}</span>
          </div>
          <a
            class:list={['button', 'button-small', !channel.primary && 'button-secondary']}
            href={channel.href}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener noreferrer' : undefined}
          >
            {channel.action}
          </a>
        </li>
      ))}
    </ul>

    <aside class="contact-page-aside" aria-labelledby="contact-next-heading">
      <span class="eyebrow">Önerilen adım</span>
      <h2 id="contact-next-heading">Teklif formunu doldurun</h2>
      <p>Ürün seçimi, kurulum tipi ve proje notlarını tek yerde paylaşmanız değerlendirmeyi hızlandırır. Mesai saatlerinde gelen taleplere genelde aynı iş günü içinde dönüş yapılır.</p>
      <div class="hero-inline-actions">
        <a class="button" href="/teklif-al/">Teklif formuna geçin <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/sss/">SSS <span aria-hidden="true">→</span></a>
      </div>
      <nav class="hub-links" aria-label="İletişim sonrası adımlar">
        <a href="/urunler/">Ürün kataloğu</a>
        <a href="/hakkimizda/">Hakkımızda</a>
        <a href="/site-haritasi/">Site haritası</a>
      </nav>
    </aside>

    <div class="contact-address-block" aria-label="Ofis ve üretim konumları">
      <a
        class="contact-address-card"
        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(companyProfile.office.mapQuery)}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-address-label">{companyProfile.office.label}</span>
        <strong>{companyProfile.office.line1}</strong>
        <span>{companyProfile.office.line2}</span>
        <em>Haritada aç <span aria-hidden="true">↗</span></em>
      </a>
      <a
        class="contact-address-card is-production"
        href={companyProfile.production.mapLinkUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-address-label">{companyProfile.production.label}</span>
        <strong>{companyProfile.production.line1}</strong>
        <span>{companyProfile.production.line2}</span>
        <span class="contact-address-coords">{companyProfile.production.coordinatesDisplay}</span>
        <em>Haritada aç <span aria-hidden="true">↗</span></em>
      </a>
    </div>
  </section>

  <QuoteCta title="LED ekran projenizi değerlendirmeye başlayalım." />
</BaseLayout>
