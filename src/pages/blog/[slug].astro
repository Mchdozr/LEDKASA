---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogCanonical, blogPosts, formatBlogDate, type BlogPost } from '../../data/blog';
import { siteUrl } from '../../data/site';

export const getStaticPaths = (() =>
  blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const canonical = `/blog/${post.slug}/`;
const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${blogCanonical(post)}#post`,
    mainEntityOfPage: blogCanonical(post),
    headline: post.title,
    description: post.seoDescription,
    datePublished: post.publishedAt,
    dateModified: post.publishedAt,
    image: new URL(post.image, siteUrl).toString(),
    inLanguage: 'tr-TR',
    articleSection: post.category,
    author: { '@id': `${siteUrl}/#organization` },
    publisher: { '@id': `${siteUrl}/#organization` },
    isPartOf: { '@id': `${siteUrl}/blog/#blog` },
  },
  {
    '@type': 'FAQPage',
    '@id': `${blogCanonical(post)}#faq`,
    mainEntity: post.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={post.seoTitle}
  description={post.seoDescription}
  canonical={canonical}
  image={post.image}
  imageAlt={post.imageAlt}
  schema={schema}
  openGraphType="article"
>
  <Breadcrumbs items={[{ label: 'Blog', url: '/blog/' }, { label: post.title }]} />

  <article class="shell blog-seo-page">
    <header class="blog-seo-hero">
      <span class="eyebrow">{post.category}</span>
      <h1>{post.title}</h1>
      <p class="blog-post-date">
        <time datetime={post.publishedAt}>{formatBlogDate(post.publishedAt)}</time>
      </p>
    </header>

    <div class="ledkasa-seo-article">
      <p class="ledkasa-seo-summary">
        <strong>Özet:</strong> {post.summary}
      </p>

      <nav class="ledkasa-seo-toc" aria-label="İçindekiler">
        <h2>İçindekiler</h2>
        <ul>
          {post.sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.heading}</a>
            </li>
          ))}
          <li><a href="#sss">Sık sorulan sorular</a></li>
          <li><a href="#ilgili">İlgili içerikler</a></li>
        </ul>
      </nav>

      <figure class="ledkasa-seo-media">
        <img
          src={post.image}
          alt={post.imageAlt}
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>{post.imageCaption}</figcaption>
      </figure>

      {post.sections.map((section) => (
        <section id={section.id} data-reveal>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
          {section.table && (
            <div class="ledkasa-seo-table-wrap">
              <table>
                <thead>
                  <tr>
                    {section.table.headers.map((header) => (
                      <th scope="col">{header}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}

      <section id="ilgili" data-reveal>
        <h2>İlgili içerikler</h2>
        <ul>
          {post.relatedProducts.map((link) => (
            <li>
              <a href={link.url}>{link.name}</a>
            </li>
          ))}
          {post.relatedLinks.map((link) => (
            <li>
              <a href={link.url}>{link.name}</a>
            </li>
          ))}
        </ul>
      </section>

      <section id="sss" data-reveal>
        <h2>Sık sorulan sorular</h2>
        {post.faqs.map((faq) => (
          <div class="ledkasa-seo-faq">
            <p>
              <strong>S: {faq.question}</strong>
            </p>
            <p>C: {faq.answer}</p>
          </div>
        ))}
      </section>

      <p class="ledkasa-seo-cta-wrap">
        <a class="ledkasa-seo-cta" href={post.ctaUrl}>{post.ctaLabel}</a>
      </p>
    </div>
  </article>
</BaseLayout>
