---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BlogCard from '../../../components/BlogCard.astro';
import BlogPagination from '../../../components/BlogPagination.astro';
import QuoteCta from '../../../components/QuoteCta.astro';
import {
  blogListCanonical,
  blogPageCount,
  blogPosts,
  formatBlogDate,
  getBlogPage,
} from '../../../data/blog';
import { siteUrl } from '../../../data/site';

export const getStaticPaths = (() =>
  Array.from({ length: blogPageCount - 1 }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  })) satisfies GetStaticPaths;

interface Props {
  page: number;
}

const { page } = Astro.props;
const pagePosts = getBlogPage(page);
const title = `LEDKASA Blog — Sayfa ${page}`;
const description = `LEDKASA blog yazıları, sayfa ${page}. LED ekran kasası ve bağlantı planlaması içerikleri.`;
const canonical = `/blog/sayfa/${page}/`;
const schema = {
  '@type': 'CollectionPage',
  '@id': `${siteUrl}/blog/sayfa/${page}/#page`,
  url: blogListCanonical(page),
  name: title,
  description,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': `${siteUrl}/blog/#blog` },
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Breadcrumbs items={[{ label: 'Blog', url: '/blog/' }, { label: `Sayfa ${page}` }]} />
  <header class="content-hero content-hero-compact shell">
    <span class="eyebrow">Blog</span>
    <h1>LED ekran kasa blogu</h1>
    <p>
      Toplam {blogPosts.length} yazı · Sayfa {page} / {blogPageCount}
    </p>
  </header>

  <section class="shell blog-directory" aria-label={`Blog yazıları sayfa ${page}`}>
    <div class="blog-card-grid">
      {pagePosts.map((post) => (
        <BlogCard post={post} dateLabel={formatBlogDate(post.publishedAt)} />
      ))}
    </div>
    <BlogPagination currentPage={page} totalPages={blogPageCount} />
  </section>
  <QuoteCta title="Blogdan projenize: kapsamı birlikte netleştirelim." />
</BaseLayout>
