---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { articles } from '../../data/articles';
import { siteUrl } from '../../data/site';

const title = 'LED Ekran Bilgi Merkezi ve Rehberler | LEDKASA';
const description = 'LED ekran kasası seçimi, rental kurulum, poster ekranlar ve kablolama için kalıcı rehberleri LEDKASA Bilgi Merkezi’nde okuyun.';
const schema = {
  '@type': 'CollectionPage',
  '@id': `${siteUrl}/bilgi-merkezi/#collection`,
  url: `${siteUrl}/bilgi-merkezi/`,
  name: 'LED Ekran Bilgi Merkezi',
  inLanguage: 'tr-TR',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `${siteUrl}/bilgi-merkezi/${article.slug}/`,
    })),
  },
};
---

<BaseLayout title={title} description={description} canonical="/bilgi-merkezi/" schema={schema}>
  <Breadcrumbs items={[{ label: 'Bilgi Merkezi' }]} />
  <header class="content-hero shell">
    <span class="eyebrow">Karar rehberleri</span>
    <h1>LED Ekran Bilgi Merkezi</h1>
    <p>Kasa, kabinet ve bağlantı ekipmanı seçimini kullanım senaryosu üzerinden değerlendirmek için hazırlanan temel rehberler.</p>
  </header>

  <section class="article-directory shell" aria-label="Bilgi merkezi yazıları">
    {articles.map((article, index) => (
      <article class:list={['article-directory-card', { 'article-directory-card-featured': index === 0 }]} data-reveal>
        <a class="article-directory-media" href={`/bilgi-merkezi/${article.slug}/`} tabindex="-1" aria-hidden="true">
          <img src={article.image} alt="" width="800" height="800" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </a>
        <div>
          <span class="eyebrow">Rehber {String(index + 1).padStart(2, '0')}</span>
          <h2><a href={`/bilgi-merkezi/${article.slug}/`}>{article.title}</a></h2>
          <p>{article.excerpt}</p>
          <a class="text-link" href={`/bilgi-merkezi/${article.slug}/`}>Rehberi okuyun <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </section>
  <QuoteCta title="Rehberlerden projenize, kapsamı birlikte netleştirelim." />
</BaseLayout>
