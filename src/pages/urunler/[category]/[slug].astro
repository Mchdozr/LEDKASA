---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import QuoteCta from '../../../components/QuoteCta.astro';
import { featuresForProductGroup } from '../../../data/manufacturer-sheets';
import { productCategories, products, siteUrl, type Product, type ProductCategory } from '../../../data/site';

export const getStaticPaths = (() =>
  products.map((product) => {
    const category = productCategories.find((entry) => entry.slug === product.categorySlug);
    if (!category) throw new Error(`Ürün kategorisi bulunamadı: ${product.categorySlug}`);
    return {
      params: { category: category.slug, slug: product.slug },
      props: {
        product,
        category,
        relatedProducts: category.products.filter((entry) => entry.slug !== product.slug).slice(0, 3),
      },
    };
  })) satisfies GetStaticPaths;

interface Props {
  product: Product;
  category: ProductCategory;
  relatedProducts: Product[];
}

const { product, category, relatedProducts } = Astro.props;
const complementaryProducts = (product.complementaryProducts ?? [])
  .map((slug) => products.find((entry) => entry.slug === slug))
  .filter((entry): entry is Product => Boolean(entry));
const isCabinet = category.slug === 'led-ekran-kasalari';
const specGroups = product.specGroups?.length
  ? product.specGroups
  : product.specs?.length
    ? [{ heading: 'Özellik özeti', note: product.specsNote, specs: product.specs }]
    : [];
const productSheetFeatures = featuresForProductGroup(product.slug);
const galleryByGroup = (product.gallery ?? []).reduce<Map<string | undefined, typeof product.gallery>>(
  (map, item) => {
    const key = item.groupKey;
    const bucket = map.get(key) ?? [];
    bucket.push(item);
    map.set(key, bucket);
    return map;
  },
  new Map(),
);
const galleryGroupLabels: Record<string, string> = {
  '960-mg': '960×960 mm Mg alaşım döküm',
  '640-small-pitch-480': '640×480-B küçük pitch',
  '640-small-pitch-family': '640 mm küçük pitch aile',
};
const schemaSpecs = specGroups.flatMap((group) => group.specs);
const hasContext =
  Boolean(product.useCases?.length) ||
  Boolean(product.relatedGuides?.length) ||
  Boolean(product.applicationLinks?.length) ||
  isCabinet;

const schema = {
  '@type': 'Product',
  '@id': `${product.canonicalUrl}#product`,
  name: product.name,
  description: product.description,
  image: new URL(product.image, siteUrl).toString(),
  url: product.canonicalUrl,
  category: category.name,
  brand: {
    '@type': 'Brand',
    name: 'LEDKASA',
  },
  ...(schemaSpecs.length > 0
    ? {
        additionalProperty: schemaSpecs.map((spec) => ({
          '@type': 'PropertyValue',
          name: spec.label,
          value: spec.value,
        })),
      }
    : {}),
};
---

<BaseLayout
  title={product.seoTitle}
  description={product.seoDescription}
  canonical={product.url}
  image={product.image}
  imageAlt={product.imageAlt}
  schema={schema}
>
  <Breadcrumbs items={[
    { label: 'Ürünler', url: '/urunler/' },
    { label: category.name, url: category.url },
    { label: product.name },
  ]} />

  <article class="product-detail shell">
    <div class="product-detail-media" data-reveal>
      <span class="product-detail-category">{category.shortName}</span>
      <img src={product.image} alt={product.imageAlt} width="1000" height="1000" decoding="async" fetchpriority="high" />
    </div>
    <div class="product-detail-copy">
      <span class="eyebrow">{category.name}</span>
      <h1>{product.name}</h1>
      <p class="product-lead">{product.description}</p>
      <ul class="feature-list" aria-label="Ürün öne çıkanları">
        {product.highlights.map((highlight) => (
          <li><span aria-hidden="true">✓</span>{highlight}</li>
        ))}
      </ul>
      <div class="product-actions">
        <a class="button" href={`/teklif-al/?urun=${encodeURIComponent(product.slug)}`}>Bu ürün için teklif alın</a>
        <a class="text-link" href={category.url}>Kategoriye dön <span aria-hidden="true">→</span></a>
      </div>
      {product.datasheets && product.datasheets.length > 0 ? (
        product.datasheets.map((sheet) => (
          <p class="product-datasheet">
            <a class="text-link" href={sheet.url} download>
              {sheet.label} <span aria-hidden="true">↓</span>
            </a>
          </p>
        ))
      ) : product.datasheetUrl ? (
        <p class="product-datasheet">
          <a class="text-link" href={product.datasheetUrl} download>
            {product.datasheetLabel ?? 'Teknik föy (PDF)'} <span aria-hidden="true">↓</span>
          </a>
        </p>
      ) : null}
      <p class="product-note">Teknik uyumluluk, adet ve teslim kapsamı proje ayrıntılarına göre değerlendirilir. Fiyat ve stok yayınlanmaz; teklif aşamasında netleştirilir.</p>
    </div>
  </article>

  {product.gallery && product.gallery.length > 0 && (
    <section class="product-gallery shell" aria-labelledby="gallery-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Doğrulanmış görseller</span>
          <h2 id="gallery-heading">Föy ile eşleşen görseller</h2>
        </div>
        <p>Her blok yalnızca ilgili kabinet ailesine aittir; 960×960 Mg ile 640×480-B karıştırılmaz.</p>
      </div>
      {[...galleryByGroup.entries()].map(([groupKey, items]) => (
        <div class="gallery-group">
          {groupKey && galleryGroupLabels[groupKey] && (
            <h3 class="gallery-group-title">{galleryGroupLabels[groupKey]}</h3>
          )}
          <ul class="product-gallery-grid">
            {items?.map((item) => (
              <li>
                <figure>
                  <img src={item.src} alt={item.alt} width="1200" height="1224" loading="lazy" decoding="async" />
                  <figcaption>{item.caption}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {specGroups.length > 0 && (
    <section class="product-specs shell" aria-labelledby="specs-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Teknik bilgiler</span>
          <h2 id="specs-heading">Özellik özeti</h2>
        </div>
        {product.specsNote && <p>{product.specsNote}</p>}
      </div>
      {specGroups.map((group) => {
        const sheetFeatures = group.groupKey
          ? featuresForProductGroup(product.slug, group.groupKey).flatMap((sheet) => sheet.features)
          : featuresForProductGroup(product.slug).flatMap((sheet) => sheet.features);
        return (
        <div class="spec-group">
          <div class="spec-group-heading">
            <h3>{group.heading}</h3>
            {group.note && <p>{group.note}</p>}
            {group.datasheetUrl && (
              <p>
                <a class="text-link" href={group.datasheetUrl} download>
                  {group.datasheetLabel ?? 'Teknik föy (PDF)'} <span aria-hidden="true">↓</span>
                </a>
              </p>
            )}
          </div>
          {sheetFeatures.length > 0 && (
            <ul class="manufacturer-feature-grid" aria-label={`${group.heading} föy özellikleri`}>
              {sheetFeatures.map((feature) => (
                <li>
                  <strong>{feature.title}</strong>
                  <p>{feature.description}</p>
                </li>
              ))}
            </ul>
          )}
          <dl class="spec-table">
            {group.specs.map((spec) => (
              <div class="spec-row">
                <dt>{spec.label}</dt>
                <dd>{spec.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        );
      })}
    </section>
  )}

  {productSheetFeatures.length > 0 && specGroups.every((group) => !group.groupKey) && (
    <section class="product-specs shell" aria-labelledby="foy-features-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Üretici föyü</span>
          <h2 id="foy-features-heading">Föyden öne çıkanlar</h2>
        </div>
      </div>
      <ul class="manufacturer-feature-grid">
        {productSheetFeatures.flatMap((sheet) => sheet.features).map((feature) => (
          <li>
            <strong>{feature.title}</strong>
            <p>{feature.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {hasContext && (
    <section class="product-context shell" aria-labelledby="context-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Proje bağlamı</span>
          <h2 id="context-heading">Ne zaman tercih edilir?</h2>
        </div>
      </div>
      <div class="product-context-grid">
        {product.useCases && product.useCases.length > 0 && (
          <div>
            <h3>Kullanım senaryoları</h3>
            <ul class="context-list">
              {product.useCases.map((useCase) => <li>{useCase}</li>)}
            </ul>
          </div>
        )}
        {product.relatedGuides && product.relatedGuides.length > 0 && (
          <div>
            <h3>İlgili rehberler</h3>
            <ul class="context-list">
              {product.relatedGuides.map((guide) => (
                <li><a href={guide.url}>{guide.name}</a></li>
              ))}
            </ul>
          </div>
        )}
        {product.applicationLinks && product.applicationLinks.length > 0 && (
          <div>
            <h3>Uygulama alanları</h3>
            <ul class="context-list">
              {product.applicationLinks.map((link) => (
                <li><a href={link.url}>{link.name}</a></li>
              ))}
            </ul>
          </div>
        )}
        {isCabinet && (
          <div>
            <h3>Karşılaştırma</h3>
            <ul class="context-list">
              <li><a href="/urunler/kasa-karsilastirma/">LED kasa karşılaştırma tablosu</a></li>
              <li><a href="/bilgi-merkezi/kasa-secimi-cnc-kapaksiz-rental-kabinet/">Kasa seçimi rehberi</a></li>
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {complementaryProducts.length > 0 && (
    <section class="related-products shell" aria-labelledby="complementary-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Birlikte değerlendirin</span>
          <h2 id="complementary-heading">Tamamlayıcı ürünler</h2>
        </div>
      </div>
      <div class="product-grid">
        {complementaryProducts.map((relatedProduct) => <ProductCard product={relatedProduct} headingLevel={3} />)}
      </div>
    </section>
  )}

  {relatedProducts.length > 0 && (
    <section class="related-products shell" aria-labelledby="related-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Aynı kategoriden</span>
          <h2 id="related-heading">İlgili ürünler</h2>
        </div>
        <a class="text-link" href={category.url}>Tümünü görün <span aria-hidden="true">→</span></a>
      </div>
      <div class="product-grid">
        {relatedProducts.map((relatedProduct) => <ProductCard product={relatedProduct} headingLevel={3} />)}
      </div>
    </section>
  )}

  <QuoteCta product={product.slug} title={`${product.name} için teklif isteyin.`} />
</BaseLayout>
