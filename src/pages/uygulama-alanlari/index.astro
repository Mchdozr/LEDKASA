---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { applicationAreas } from '../../data/articles';
import { siteUrl } from '../../data/site';

const title = 'LED Ekran Uygulama Alanları | LEDKASA';
const description = 'Etkinlik ve sahne, mağaza ve showroom, kurumsal ve reklam projeleri için LED ekran kasa kullanım senaryolarını keşfedin.';
const schema = {
  '@type': 'CollectionPage',
  '@id': `${siteUrl}/uygulama-alanlari/#collection`,
  url: `${siteUrl}/uygulama-alanlari/`,
  name: 'LED Ekran Uygulama Alanları',
  description,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: applicationAreas.length,
    itemListElement: applicationAreas.map((area, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: area.title,
      url: `${siteUrl}/uygulama-alanlari/${area.slug}/`,
    })),
  },
};
---

<BaseLayout title={title} description={description} canonical="/uygulama-alanlari/" schema={schema}>
  <Breadcrumbs items={[{ label: 'Uygulama Alanları' }]} />
  <header class="content-hero content-hero-compact shell">
    <span class="eyebrow">Kullanım senaryoları</span>
    <h1>LED Ekran Uygulama Alanları</h1>
    <p>Doğru ürün ailesini ekranın kullanılacağı ortam, kurulum biçimi ve bağlantı ihtiyacından yola çıkarak belirleyin.</p>
  </header>

  <section class="shell" aria-labelledby="mission-apps">
    <div class="mission-band" data-reveal>
      <div>
        <span class="eyebrow">LEDKASA yaklaşımı</span>
        <h2 id="mission-apps">Senaryodan ürüne, üründen teklife.</h2>
      </div>
      <p>
        LEDKASA; LED ekran kasası ile güç ve bağlantı ekipmanlarını proje bağlamında netleştirir.
        Önce kullanım senaryosunu seçin, ardından ilgili <a href="/urunler/">ürün ailesini</a> ve
        <a href="/bilgi-merkezi/">rehberleri</a> inceleyin; kapsamı <a href="/teklif-al/">teklif formunda</a> paylaşın.
      </p>
    </div>

    <ul class="decision-matrix" aria-label="Senaryoya göre ürün ailesi">
      {applicationAreas.map((area) => (
        <li data-reveal>
          <strong>{area.title}</strong>
          <span>{area.productFamilyHint}. {area.summary}</span>
          <a href={`/uygulama-alanlari/${area.slug}/`}>Alanı incele <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="application-directory shell" aria-label="Uygulama alanları">
    {applicationAreas.map((area, index) => (
      <article class="application-feature" data-reveal>
        <a class="application-feature-media" href={`/uygulama-alanlari/${area.slug}/`} tabindex="-1" aria-hidden="true">
          <img src={area.image} alt="" width="800" height="800" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </a>
        <div>
          <span class="eyebrow">0{index + 1} · {area.eyebrow}</span>
          <h2><a href={`/uygulama-alanlari/${area.slug}/`}>{area.title}</a></h2>
          <p>{area.summary}</p>
          <div class="hub-links">
            <a href={`/uygulama-alanlari/${area.slug}/`}>Alanı inceleyin →</a>
            {area.guideLinks.slice(0, 1).map((guide) => <a href={guide.url}>{guide.name}</a>)}
            <a href="/teklif-al/">Teklif Al</a>
          </div>
        </div>
      </article>
    ))}
  </section>
  <QuoteCta title="Uygulama alanınıza uygun ürünleri birlikte değerlendirelim." />
</BaseLayout>
