---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { applicationAreas, articles, faqItems } from '../data/articles';
import { productCategories, products, siteUrl } from '../data/site';

const title = 'LEDKASA | LED Ekran Kasası ve Bağlantı Çözümleri';
const description = 'LED ekran kasaları, rental kabinetler, poster kasalar ve bağlantı ekipmanlarını proje ihtiyacınıza göre LEDKASA ile değerlendirin. Teklif odaklı B2B çözüm.';
const featuredProducts = [products[0], products[2], products[4]];
const heroSlides = [
  {
    eyebrow: 'LED ekran kasa çözümleri',
    title: 'LED ekran projelerine doğru kasa ile başlayın.',
    text: 'Sabit kurulumdan rental ve poster ekranlara, kasa ile bağlantı ekipmanlarını tek proje çerçevesinde değerlendirin.',
    image: '/assets/images/hero/cnc-led-kasa.webp',
    alt: 'Sabit LED ekran projelerine yönelik CNC LED kasa',
    link: '/urunler/led-ekran-kasalari/',
    linkText: 'LED kasaları inceleyin',
  },
  {
    eyebrow: 'Etkinlik ve sahne',
    title: 'Rental kurulumlarda modüler düşünün.',
    text: 'Kabinet yerleşimi, güç ve veri bağlantısı ile kurulum akışını birlikte planlayın.',
    image: '/assets/images/hero/rental-led-kabinet.webp',
    alt: 'Etkinlik ve sahne kurulumları için rental LED kabinet',
    link: '/uygulama-alanlari/etkinlik-ve-sahne/',
    linkText: 'Uygulama alanını keşfedin',
  },
  {
    eyebrow: 'Dikey dijital iletişim',
    title: 'Poster ekranlarla görünür bir iletişim alanı kurun.',
    text: 'Mağaza, showroom ve karşılama alanlarındaki dikey ekran ihtiyaçları için poster kasa seçeneklerini karşılaştırın.',
    image: '/assets/images/hero/poster-led-kasa.webp',
    alt: 'Mağaza ve showroom alanlarına yönelik poster LED kasa',
    link: '/urunler/led-ekran-kasalari/poster-led-kasa/',
    linkText: 'Poster kasayı inceleyin',
  },
];

const previewFaqs = faqItems.slice(0, 4);
const schema = [
  {
    '@type': 'WebPage',
    '@id': `${siteUrl}/#webpage`,
    url: `${siteUrl}/`,
    name: title,
    description,
    inLanguage: 'tr-TR',
  },
  {
    '@type': 'FAQPage',
    '@id': `${siteUrl}/#faq`,
    url: `${siteUrl}/`,
    name: 'Sık sorulan sorular',
    inLanguage: 'tr-TR',
    mainEntity: previewFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical="/" schema={schema} bodyClass="home-page">
  <section class="hero" data-hero aria-roledescription="carousel" aria-label="Öne çıkan LED ekran çözümleri">
    <div class="hero-track" data-hero-track aria-live="off">
      <div class="hero-ambiance" aria-hidden="true"></div>
      {heroSlides.map((slide, index) => (
        <article
          class="hero-slide"
          data-hero-slide
          aria-roledescription="slide"
          aria-label={`${index + 1} / ${heroSlides.length}`}
        >
          <div class="hero-copy">
            <span class="eyebrow">{slide.eyebrow}</span>
            {index === 0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}
            <p>{slide.text}</p>
            <div class="hero-actions">
              <a class="button" href={slide.link}>{slide.linkText} <span aria-hidden="true">→</span></a>
              <a class="text-link" href="/teklif-al/">Projeniz için teklif alın</a>
            </div>
          </div>
          <div class="hero-media">
            <span class="hero-index" aria-hidden="true">0{index + 1}</span>
            <img
              src={slide.image}
              alt={slide.alt}
              width="800"
              height="800"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          </div>
        </article>
      ))}
    </div>
    <div class="hero-controls" aria-label="Slayt kontrolleri">
      <button type="button" data-hero-previous aria-label="Önceki slayt">←</button>
      <span data-hero-status>1 / 3</span>
      <button type="button" data-hero-next aria-label="Sonraki slayt">→</button>
      <button type="button" data-hero-pause aria-label="Slayt gösterisini duraklat" aria-pressed="false">Duraklat</button>
      <span class="visually-hidden" data-hero-announcement aria-live="polite" aria-atomic="true"></span>
    </div>
  </section>

  <section class="home-section shell" aria-labelledby="catalog-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Ürün kataloğu</span>
        <h2 id="catalog-heading">Kasadan bağlantıya bütünlüklü bakış</h2>
      </div>
      <p>Kurulum biçiminize uygun kasa ailesinden başlayın, güç ve veri bağlantısı için gereken ekipmanları aynı kapsamda inceleyin.</p>
    </div>
    <div class="category-grid">
      {productCategories.map((category) => (
        <a class="category-card category-card-compact" href={category.url} data-reveal>
          <img src={category.image} alt="" width="800" height="800" loading="lazy" decoding="async" />
          <span class="category-card-shade"></span>
          <span class="category-card-content">
            <small>{String(category.products.length).padStart(2, '0')} ürün</small>
            <strong>{category.name}</strong>
            <span>{category.description}</span>
            <i aria-hidden="true">→</i>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section shell" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Öne çıkanlar</span>
        <h2 id="featured-heading">Başlangıç ürünleri</h2>
      </div>
      <a class="text-link" href="/urunler/">Tüm ürünleri görün <span aria-hidden="true">→</span></a>
    </div>
    <div class="product-grid">
      {featuredProducts.map((product) => <ProductCard product={product} headingLevel={3} />)}
    </div>
  </section>

  <section class="home-section application-band" aria-labelledby="application-heading">
    <div class="shell">
      <div class="section-heading section-heading-light">
        <div>
          <span class="eyebrow">Uygulama alanları</span>
          <h2 id="application-heading">Ekranın kullanılacağı yerden başlayın</h2>
        </div>
        <p>Ürün seçimini kullanım senaryosu, kurulum biçimi ve bağlantı düzeni üzerinden daraltın.</p>
      </div>
      <div class="application-grid">
        {applicationAreas.map((area, index) => (
          <a class="application-card" href={`/uygulama-alanlari/${area.slug}/`} data-reveal>
            <span>0{index + 1}</span>
            <h3>{area.title}</h3>
            <p>{area.summary}</p>
            <strong>Alanı inceleyin <i aria-hidden="true">→</i></strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section shell" aria-labelledby="capability-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Çalışma yaklaşımı</span>
        <h2 id="capability-heading">Üründen önce ihtiyacı netleştirin</h2>
      </div>
      <p>Fiyat, kapsam ve teknik uyumluluk; paylaşılan proje bilgileri üzerinden teklif aşamasında değerlendirilir.</p>
    </div>
    <div class="value-grid">
      <article data-reveal><span>01</span><h3>Kullanım alanı</h3><p>Sabit, geçici veya dikey ekran senaryosunu tarif edin.</p></article>
      <article data-reveal><span>02</span><h3>Kasa yaklaşımı</h3><p>Montaj, erişim ve yerleşim koşullarına uygun ürün ailesini karşılaştırın.</p></article>
      <article data-reveal><span>03</span><h3>Bağlantı kapsamı</h3><p>Güç, veri ve modül bağlantısı ihtiyacını kasa düzeniyle birlikte ele alın.</p></article>
    </div>
  </section>

  <section class="home-section process-section" aria-labelledby="process-heading">
    <div class="shell process-layout">
      <div class="process-intro" data-reveal>
        <span class="eyebrow">Teklif süreci</span>
        <h2 id="process-heading">Projenizi üç adımda netleştirelim</h2>
        <p>Kısa bir proje özetiyle başlayın; ürün kapsamını ve bağlantı ihtiyaçlarını teklif öncesinde birlikte değerlendirelim.</p>
        <a class="button" href="/teklif-al/">Teklif formuna geçin <span aria-hidden="true">→</span></a>
      </div>
      <ol class="process-list">
        <li data-reveal><span>01</span><div><h3>İhtiyacınızı paylaşın</h3><p>Kullanım alanı, ürün grubu ve proje kapsamını aktarın.</p></div></li>
        <li data-reveal><span>02</span><div><h3>Ürün kapsamı değerlendirilsin</h3><p>Kasa ve bağlantı ekipmanları ihtiyaca göre ele alınsın.</p></div></li>
        <li data-reveal><span>03</span><div><h3>Proje teklifini inceleyin</h3><p>Netleşen kapsam üzerinden hazırlanan teklifi değerlendirin.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="home-section shell knowledge-preview" aria-labelledby="knowledge-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Bilgi merkezi</span>
        <h2 id="knowledge-heading">Karar vermeden önce okuyun</h2>
      </div>
      <a class="text-link" href="/bilgi-merkezi/">Tüm rehberler <span aria-hidden="true">→</span></a>
    </div>
    <div class="editorial-grid">
      {articles.slice(0, 3).map((article) => (
        <article class="editorial-card" data-reveal>
          <a href={`/bilgi-merkezi/${article.slug}/`} tabindex="-1" aria-hidden="true">
            <img src={article.image} alt="" width="800" height="800" loading="lazy" decoding="async" />
          </a>
          <div><span class="eyebrow">Rehber</span><h3><a href={`/bilgi-merkezi/${article.slug}/`}>{article.title}</a></h3><p>{article.excerpt}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section shell faq-preview" aria-labelledby="faq-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Merak edilenler</span>
        <h2 id="faq-heading">Sık sorulan sorular</h2>
      </div>
      <a class="text-link" href="/sss/">Tüm sorular <span aria-hidden="true">→</span></a>
    </div>
    <div class="faq-list">
      {faqItems.slice(0, 4).map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
    </div>
  </section>

  <QuoteCta title="Doğru ürün kapsamını birlikte belirleyelim." />
</BaseLayout>
