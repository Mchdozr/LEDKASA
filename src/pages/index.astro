---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGroup from '../components/ProductGroup.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { getProductsByCategory } from '../data/products';
import { site } from '../data/site';
import heroImage from '../assets/products/cnc-kasa.png';

const kasalar = getProductsByCategory('kasalar');
const baglanti = getProductsByCategory('baglanti');

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  description: site.description,
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'LEDKASA Ürün Portföyü',
  itemListElement: [...kasalar, ...baglanti].map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${site.url}/urunler/${product.slug}`,
    name: product.title,
  })),
};
---

<BaseLayout
  title="LEDKASA | LED Kasa ve Bağlantı Çözümleri"
  description={site.description}
  canonicalPath="/"
  home
  jsonLd={[organizationLd, itemListLd]}
>
  <main id="top">
    <section class="hero" aria-label="LEDKASA ana görsel">
      <div class="hero-media">
        <Image
          src={heroImage}
          alt="CNC LED ekran kasa — LEDKASA ürün atmosferi"
          widths={[720, 1080, 1600, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={78}
        />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow">LED ekran sistemleri için</p>
        <p class="hero-brand">LED<span>KASA</span></p>
        <h1>Bağlantının <em>güçlü</em> tarafı.</h1>
        <p class="hero-text">
          Profesyonel LED ekran kurulumlarında ihtiyaç duyduğunuz kasaları, güç, veri ve bağlantı
          ekipmanlarını tek noktada buluşturuyoruz.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#urunler">Ürünleri incele <b>→</b></a>
          <a class="text-link" href="#iletisim">Bizimle iletişime geçin</a>
        </div>
      </div>
      <div class="scroll-hint">Kaydırın <span></span></div>
    </section>

    <section class="section intro reveal" id="hakkimizda">
      <p class="eyebrow">LEDKASA standartları</p>
      <div class="intro-grid">
        <h2>Sahada güven.<br /><em>Her bağlantıda.</em></h2>
        <p>
          Her ürünümüz; performans, uyumluluk ve uzun kullanım ömrü düşünülerek seçilir. Projenizin
          ölçeği ne olursa olsun, doğru ekipmanla sorunsuz sistemler kurmanıza yardımcı oluruz.
        </p>
      </div>
      <div class="metrics">
        <div>
          <strong>9</strong>
          <span>Temel ürün grubu</span>
        </div>
        <div>
          <strong>100%</strong>
          <span>Proje odaklı çözüm</span>
        </div>
        <div>
          <strong>01</strong>
          <span>Güvenilir tedarik noktası</span>
        </div>
      </div>
    </section>

    <section class="section products reveal" id="urunler" style="background: rgba(231,233,226,.72);">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Ürün portföyü</p>
          <h2>İşinize uygun<br /><em>doğru bağlantı.</em></h2>
        </div>
        <p>
          LED ekran kasalarından saha bağlantı ekipmanlarına kadar, projenizi tamamlayan güvenilir
          çözümler.
        </p>
      </div>
      <ProductGroup category="kasalar" products={kasalar} />
      <ProductGroup category="baglanti" products={baglanti} second />
      <div class="contact-cta-row" style="margin-top:42px;">
        <a class="button button-primary" href="/urunler">Tüm katalog <b>→</b></a>
        <a class="text-link" href="#iletisim">Teklif için iletişime geçin</a>
      </div>
    </section>

    <section class="promise reveal">
      <div class="promise-art" aria-hidden="true">
        <div class="grid-lines"></div>
        <div class="signal"><i></i><i></i><i></i></div>
      </div>
      <div>
        <p class="eyebrow">Tek noktadan çözüm</p>
        <h2>Kurulumunuzda<br />sürprize <em>yer yok.</em></h2>
        <p>
          İhtiyacınızı anlatın; uygun ürün seçiminde size yardımcı olalım. Doğru bağlantı, güçlü bir
          ekran sisteminin başlangıcıdır.
        </p>
        <a class="button button-light" href="#iletisim">Teklif isteyin <b>→</b></a>
      </div>
    </section>

    <ContactStrip />
  </main>
</BaseLayout>
